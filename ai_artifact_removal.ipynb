  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-ui",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# INTERACTIVE UI - ipywidgets control panel\n",
    "# ============================================================\n",
    "\n",
    "_state = {'original': None, 'result': None, 'amap': None, 'filepath': None}\n",
    "\n",
    "\n",
    "def _bgr_to_b64(img_bgr: np.ndarray, quality: int = 88) -> str:\n",
    "    \"\"\"Convert BGR ndarray to JPEG base64 string for HTML embedding.\"\"\"\n",
    "    rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "    pil = PILImage.fromarray(rgb)\n",
    "    buf = io.BytesIO()\n",
    "    pil.save(buf, format='JPEG', quality=quality)\n",
    "    return base64.b64encode(buf.getvalue()).decode()\n",
    "\n",
    "\n",
    "def _show_comparison_slider(orig: np.ndarray, result: np.ndarray,\n",
    "                              max_w: int = 820) -> None:\n",
    "    \"\"\"Render an interactive before/after drag-slider via HTML + JavaScript.\"\"\"\n",
    "    h, w = orig.shape[:2]\n",
    "    scale  = min(1.0, max_w / w)\n",
    "    dw, dh = int(w * scale), int(h * scale)\n",
    "\n",
    "    o_b64 = _bgr_to_b64(cv2.resize(orig,   (dw, dh)))\n",
    "    r_b64 = _bgr_to_b64(cv2.resize(result, (dw, dh)))\n",
    "\n",
    "    html = (\n",
    "        '<style>'\n",
    "        f'.cmp-wrap{{position:relative;width:{dw}px;height:{dh}px;border:2px solid #444;'\n",
    "        'overflow:hidden;cursor:col-resize;user-select:none;border-radius:6px}}'\n",
    "        f'.cmp-wrap img{{position:absolute;top:0;left:0;width:{dw}px;height:{dh}px}}'\n",
    "        f'.cmp-clip{{position:absolute;top:0;left:0;width:{dw//2}px;height:{dh}px;overflow:hidden}}'\n",
    "        f'.cmp-div{{position:absolute;top:0;left:{dw//2-1}px;width:3px;height:{dh}px;'\n",
    "        'background:rgba(255,255,255,.9);box-shadow:0 0 6px rgba(0,0,0,.7)}}'\n",
    "        f'.cmp-hdl{{position:absolute;top:{dh//2-22}px;left:{dw//2-22}px;'\n",
    "        'width:44px;height:44px;border-radius:50%;background:white;border:2px solid #333;'\n",
    "        'box-shadow:0 0 8px rgba(0,0,0,.5);display:flex;align-items:center;'\n",
    "        'justify-content:center;font-size:18px;font-weight:bold;color:#333}}'\n",
    "        '.lbl{position:absolute;top:8px;padding:3px 9px;border-radius:4px;'\n",
    "        'font:bold 12px/1 sans-serif;color:#fff}'\n",
    "        '.lbl-b{left:8px;background:rgba(0,0,0,.55)}'\n",
    "        '.lbl-a{right:8px;background:rgba(0,120,0,.65)}'\n",
    "        '</style>'\n",
    "        '<p style=\"font:bold 14px sans-serif;margin:8px 0\">Drag to compare BEFORE / AFTER</p>'\n",
    "        '<div class=\"cmp-wrap\" id=\"cmpW\">'\n",
    "        f'<img src=\"data:image/jpeg;base64,{r_b64}\" />'\n",
    "        '<div class=\"cmp-clip\" id=\"cmpC\">'\n",
    "        f'<img src=\"data:image/jpeg;base64,{o_b64}\" />'\n",
    "        '</div>'\n",
    "        '<div class=\"cmp-div\" id=\"cmpD\"></div>'\n",
    "        '<div class=\"cmp-hdl\" id=\"cmpH\">&#8596;</div>'\n",
    "        '<span class=\"lbl lbl-b\">BEFORE</span>'\n",
    "        '<span class=\"lbl lbl-a\">AFTER</span>'\n",
    "        '</div>'\n",
    "        '<script>(function(){'\n",
    "        'var wrap=document.getElementById(\"cmpW\");'\n",
    "        'var clip=document.getElementById(\"cmpC\");'\n",
    "        'var div=document.getElementById(\"cmpD\");'\n",
    "        'var hdl=document.getElementById(\"cmpH\");'\n",
    "        f'var W={dw};'\n",
    "        'var drag=false;'\n",
    "        'function pos(x){x=Math.max(0,Math.min(W,x));clip.style.width=x+\'px\';div.style.left=(x-1)+\'px\';hdl.style.left=(x-22)+\'px\'}'\n",
    "        'wrap.addEventListener(\'mousedown\',function(e){drag=true;e.preventDefault()});'\n",
    "        'document.addEventListener(\'mousemove\',function(e){if(!drag)return;pos(e.clientX-wrap.getBoundingClientRect().left)});'\n",
    "        'document.addEventListener(\'mouseup\',function(){drag=false});'\n",
    "        'wrap.addEventListener(\'touchstart\',function(){drag=true});'\n",
    "        'document.addEventListener(\'touchmove\',function(e){if(!drag)return;pos(e.touches[0].clientX-wrap.getBoundingClientRect().left)});'\n",
    "        'document.addEventListener(\'touchend\',function(){drag=false});'\n",
    "        '})();</script>'\n",
    "    )\n",
    "    display(HTML(html))\n",
    "\n",
    "\n",
    "def _show_artifact_map(amap: np.ndarray) -> None:\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
    "    axes[0].imshow(cv2.cvtColor(_state['original'], cv2.COLOR_BGR2RGB))\n",
    "    axes[0].set_title('Original'); axes[0].axis('off')\n",
    "    im = axes[1].imshow(amap, cmap='hot', vmin=0, vmax=1)\n",
    "    axes[1].set_title('Artifact Map'); axes[1].axis('off')\n",
    "    plt.colorbar(im, ax=axes[1], fraction=0.046)\n",
    "    axes[2].imshow(cv2.cvtColor(_state['result'], cv2.COLOR_BGR2RGB))\n",
    "    axes[2].set_title('Cleaned'); axes[2].axis('off')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "file_opts = ([(os.path.basename(f), f) for f in ARTWORK_FILES]\n",
    "             if ARTWORK_FILES else [('(no images found)', None)])\n",
    "\n",
    "w_file = widgets.Dropdown(options=file_opts, description='Image:',\n",
    "                           layout=widgets.Layout(width='90%'),\n",
    "                           style={'description_width': '80px'})\n",
    "\n",
    "slider_kw = dict(style={'description_width': 'initial'},\n",
    "                  layout=widgets.Layout(width='90%'))\n",
    "\n",
    "w_artifact = widgets.FloatSlider(value=1.0, min=0.1, max=2.0, step=0.1,\n",
    "    description='Artifact detection strength:', **slider_kw)\n",
    "w_denoise  = widgets.FloatSlider(value=1.0, min=0.1, max=2.0, step=0.1,\n",
    "    description='Denoising strength:', **slider_kw)\n",
    "w_restore  = widgets.FloatSlider(value=0.7, min=0.0, max=1.0, step=0.05,\n",
    "    description='Restoration blend strength:', **slider_kw)\n",
    "\n",
    "w_model = widgets.RadioButtons(\n",
    "    options=[\n",
    "        ('RealESRGAN General - best for photos',       'realesrgan_general'),\n",
    "        ('RealESRGAN Anime  - best for illustrations', 'realesrgan_anime'),\n",
    "        ('SwinIR - transformer-based (slower)',        'swinir'),\n",
    "        ('None - classical pipeline only',             'none'),\n",
    "    ],\n",
    "    value='realesrgan_general',\n",
    "    description='Model:',\n",
    "    style={'description_width': '80px'},\n",
    "    layout=widgets.Layout(width='90%'))\n",
    "\n",
    "w_tile = widgets.IntSlider(value=512, min=128, max=1024, step=128,\n",
    "    description='Tile size (VRAM: lower = safer):', **slider_kw)\n",
    "\n",
    "w_show_map = widgets.Checkbox(value=True,\n",
    "    description='Show artifact map + side-by-side after run')\n",
    "\n",
    "w_run  = widgets.Button(description='Run Artifact Removal',\n",
    "    button_style='primary', icon='magic',\n",
    "    layout=widgets.Layout(width='260px', height='44px'))\n",
    "w_save = widgets.Button(description='Save Result to Drive',\n",
    "    button_style='success', icon='download',\n",
    "    layout=widgets.Layout(width='260px', height='44px'), disabled=True)\n",
    "\n",
    "w_status = widgets.Label(value='Ready - select an image and press Run.')\n",
    "w_out    = widgets.Output()\n",
    "\n",
    "\n",
    "def _on_run(b):\n",
    "    with w_out:\n",
    "        clear_output(wait=True)\n",
    "        fpath = w_file.value\n",
    "        if fpath is None:\n",
    "            print('No image selected.'); return\n",
    "        w_status.value = f'Loading {os.path.basename(fpath)} ...'\n",
    "        img = cv2.imread(fpath, cv2.IMREAD_COLOR)\n",
    "        if img is None:\n",
    "            print(f'Could not read: {fpath}'); return\n",
    "        h, w = img.shape[:2]\n",
    "        print(f'Loaded: {os.path.basename(fpath)}  ({w} x {h} px)')\n",
    "        _state.update(original=img.copy(), filepath=fpath)\n",
    "        w_status.value = 'Running pipeline...'\n",
    "        print('=' * 60)\n",
    "        result, amap = run_pipeline(\n",
    "            img,\n",
    "            artifact_strength=w_artifact.value,\n",
    "            denoise_strength=w_denoise.value,\n",
    "            restoration_strength=w_restore.value,\n",
    "            restoration_model=w_model.value,\n",
    "            tile_size=w_tile.value,\n",
    "        )\n",
    "        print('=' * 60)\n",
    "        _state.update(result=result, amap=amap)\n",
    "        if w_show_map.value:\n",
    "            _show_artifact_map(amap)\n",
    "        _show_comparison_slider(img, result)\n",
    "        w_save.disabled = False\n",
    "        w_status.value  = 'Done! Use Save to export to Google Drive.'\n",
    "\n",
    "\n",
    "def _on_save(b):\n",
    "    with w_out:\n",
    "        if _state['result'] is None:\n",
    "            print('Nothing to save.'); return\n",
    "        name, ext = os.path.splitext(os.path.basename(_state['filepath']))\n",
    "        out_img = os.path.join(OUTPUT_DIR, f'{name}_cleaned{ext}')\n",
    "        out_map = os.path.join(OUTPUT_DIR, f'{name}_artifact_map.png')\n",
    "        cv2.imwrite(out_img, _state['result'])\n",
    "        heat = cv2.applyColorMap((_state['amap'] * 255).astype(np.uint8), cv2.COLORMAP_HOT)\n",
    "        cv2.imwrite(out_map, heat)\n",
    "        print(f'Saved:\\n  {out_img}\\n  {out_map}')\n",
    "        w_status.value = f'Saved to {OUTPUT_DIR}'\n",
    "\n",
    "\n",
    "w_run.on_click(_on_run)\n",
    "w_save.on_click(_on_save)\n",
    "\n",
    "_header = widgets.HTML(\n",
    "    '<div style=\"background:linear-gradient(135deg,#12172a,#1c2e4a);color:#f0f4ff;'\n",
    "    'padding:18px 22px;border-radius:10px;margin-bottom:10px;\">'\n",
    "    '<h2 style=\"margin:0;font-size:20px;\">AI Artifact Removal Pipeline</h2>'\n",
    "    '<p style=\"margin:6px 0 0;opacity:.75;font-size:12px;\">'\n",
    "    '5-stage: Detection > Preservation > Suppression > AI Restoration > Refinement'\n",
    "    '</p></div>'\n",
    ")\n",
    "\n",
    "_panel = widgets.VBox([\n",
    "    _header,\n",
    "    widgets.HTML('<b>Select image from /artwork</b>'),\n",
    "    w_file,\n",
    "    widgets.HTML('<hr style=\"margin:8px 0\"><b>Pipeline parameters</b>'),\n",
    "    w_artifact, w_denoise, w_restore,\n",
    "    widgets.HTML('<b>Restoration model</b>'),\n",
    "    w_model, w_tile, w_show_map,\n",
    "    widgets.HTML('<hr style=\"margin:8px 0\">'),\n",
    "    widgets.HBox([w_run, widgets.HTML('&nbsp;'), w_save]),\n",
    "    w_status,\n",
    "], layout=widgets.Layout(padding='12px'))\n",
    "\n",
    "display(_panel, w_out)\n"
   ]
  },
