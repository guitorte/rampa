  {
   "cell_type": "markdown",
   "id": "c-s1-md",
   "metadata": {},
   "source": [
    "## Stage 1 - Artifact Detection\n",
    "Six maps (edge density, FFT, entropy, Laplacian, wavelet, autocorrelation) fused into one probability map.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-stage1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STAGE 1 - Artifact Detection\n",
    "\n",
    "def _norm(a):\n",
    "    mn, mx = a.min(), a.max()\n",
    "    if mx - mn < 1e-8:\n",
    "        return np.zeros_like(a, dtype=np.float32)\n",
    "    return ((a - mn) / (mx - mn)).astype(np.float32)\n",
    "\n",
    "\n",
    "def edge_density_map(gray, win=16):\n",
    "    edges = cv2.Canny(gray, 50, 150).astype(np.float32)\n",
    "    k = np.ones((win, win), np.float32) / (win * win)\n",
    "    return _norm(cv2.filter2D(edges, -1, k))\n",
    "\n",
    "\n",
    "def fft_artifact_map(gray, sigma=2.5):\n",
    "    f = np.fft.fft2(gray.astype(np.float64))\n",
    "    fs = np.fft.fftshift(f)\n",
    "    mag = np.log1p(np.abs(fs))\n",
    "    mask = mag > (mag.mean() + sigma * mag.std())\n",
    "    h, w = gray.shape\n",
    "    cy, cx = h // 2, w // 2\n",
    "    r = min(h, w) // 20\n",
    "    mask[cy-r:cy+r, cx-r:cx+r] = False\n",
    "    fs2 = np.zeros_like(fs)\n",
    "    fs2[mask] = fs[mask]\n",
    "    sp = np.abs(np.fft.ifft2(np.fft.ifftshift(fs2)))\n",
    "    return _norm(cv2.resize(sp.astype(np.float32), (w, h)))\n",
    "\n",
    "\n",
    "def entropy_map(gray, radius=5):\n",
    "    from skimage.filters.rank import entropy as sk_ent\n",
    "    from skimage.morphology import disk\n",
    "    return _norm(sk_ent(gray.astype(np.uint8), disk(radius)).astype(np.float32))\n",
    "\n",
    "\n",
    "def laplacian_var_map(gray, win=16):\n",
    "    lap = cv2.Laplacian(gray.astype(np.float32), cv2.CV_32F) ** 2\n",
    "    k = np.ones((win, win), np.float32) / (win * win)\n",
    "    return _norm(cv2.filter2D(lap, -1, k))\n",
    "\n",
    "\n",
    "def wavelet_artifact_map(gray, wavelet='db4', levels=3):\n",
    "    coeffs = pywt.wavedec2(gray.astype(np.float64) / 255.0, wavelet, level=levels)\n",
    "    h, w = gray.shape\n",
    "    acc = np.zeros((h, w), np.float32)\n",
    "    for tup in coeffs[1:]:\n",
    "        for d in tup:\n",
    "            d2 = cv2.resize(np.abs(d).astype(np.float32), (w, h))\n",
    "            mu, sd = d2.mean(), d2.std() + 1e-8\n",
    "            acc += np.clip((d2 - (mu + 2*sd)) / sd, 0, None)\n",
    "    return _norm(acc)\n",
    "\n",
    "\n",
    "def repetition_map(gray, r=16):\n",
    "    ps = np.abs(np.fft.fft2(gray.astype(np.float64))) ** 2\n",
    "    ac = np.fft.fftshift(np.real(np.fft.ifft2(ps)))\n",
    "    h, w = ac.shape\n",
    "    cy, cx = h//2, w//2\n",
    "    ac[cy-r:cy+r, cx-r:cx+r] = 0\n",
    "    return _norm(cv2.resize(np.abs(ac).astype(np.float32), (w, h)))\n",
    "\n",
    "\n",
    "def generate_artifact_map(img_bgr, strength=1.0):\n",
    "    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)\n",
    "    print('  [1/6] edge density', end=' ... ', flush=True)\n",
    "    m1 = edge_density_map(gray);   print('ok')\n",
    "    print('  [2/6] FFT',           end=' ... ', flush=True)\n",
    "    m2 = fft_artifact_map(gray);   print('ok')\n",
    "    print('  [3/6] entropy',        end=' ... ', flush=True)\n",
    "    m3 = entropy_map(gray);        print('ok')\n",
    "    print('  [4/6] laplacian',      end=' ... ', flush=True)\n",
    "    m4 = laplacian_var_map(gray);  print('ok')\n",
    "    print('  [5/6] wavelet',        end=' ... ', flush=True)\n",
    "    m5 = wavelet_artifact_map(gray); print('ok')\n",
    "    print('  [6/6] repetition',     end=' ... ', flush=True)\n",
    "    m6 = repetition_map(gray);     print('ok')\n",
    "    fused = 0.15*m1 + 0.25*m2 + 0.15*m3 + 0.20*m4 + 0.15*m5 + 0.10*m6\n",
    "    fused = cv2.GaussianBlur(np.clip(fused * strength, 0, 1), (25, 25), 0)\n",
    "    return _norm(fused)\n",
    "\n",
    "print('Stage 1 loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c-s2-md",
   "metadata": {},
   "source": [
    "## Stage 2 - Structural Preservation\n",
    "Multi-scale Canny edges + Sobel gradient combined into a preservation mask.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-stage2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STAGE 2 - Structural Preservation\n",
    "\n",
    "def major_edges(img_bgr):\n",
    "    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)\n",
    "    e = cv2.bitwise_or(cv2.bitwise_or(\n",
    "        cv2.Canny(gray, 20, 80),\n",
    "        cv2.Canny(gray, 50, 150)),\n",
    "        cv2.Canny(gray, 80, 200))\n",
    "    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n",
    "    return cv2.dilate(e, k, iterations=2).astype(np.float32) / 255.0\n",
    "\n",
    "\n",
    "def gradient_magnitude(img_bgr):\n",
    "    g = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "    return _norm(np.sqrt(cv2.Sobel(g, cv2.CV_32F, 1, 0)**2 +\n",
    "                         cv2.Sobel(g, cv2.CV_32F, 0, 1)**2))\n",
    "\n",
    "\n",
    "def build_preservation_mask(img_bgr, edge_w=0.65):\n",
    "    mask = edge_w * major_edges(img_bgr) + (1-edge_w) * gradient_magnitude(img_bgr)\n",
    "    return cv2.GaussianBlur(np.clip(mask, 0, 1), (15, 15), 0).astype(np.float32)\n",
    "\n",
    "print('Stage 2 loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c-s3-md",
   "metadata": {},
   "source": [
    "## Stage 3 - Artifact Suppression\n",
    "Five classical filters ensembled and composited only where artifact_map is high and preservation_mask is low.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-stage3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STAGE 3 - Artifact Suppression\n",
    "\n",
    "def nlm_denoise(img, h_lum=10, h_col=10):\n",
    "    return cv2.fastNlMeansDenoisingColored(\n",
    "        img, None, h=h_lum, hColor=h_col,\n",
    "        templateWindowSize=7, searchWindowSize=21)\n",
    "\n",
    "\n",
    "def bilateral_denoise(img, sigma=1.0):\n",
    "    d = max(5, int(9*sigma))\n",
    "    return cv2.bilateralFilter(img, d, int(75*sigma), int(75*sigma))\n",
    "\n",
    "\n",
    "def wavelet_denoise(img):\n",
    "    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB).astype(np.float32) / 255.0\n",
    "    dn = denoise_wavelet(rgb, method='BayesShrink', mode='soft',\n",
    "                          wavelet='db4', wavelet_levels=3, channel_axis=-1)\n",
    "    return cv2.cvtColor((np.clip(dn, 0, 1)*255).astype(np.uint8), cv2.COLOR_RGB2BGR)\n",
    "\n",
    "\n",
    "def frequency_cleanup(img, sigma=3.0, suppress=0.15):\n",
    "    out = img.astype(np.float32)\n",
    "    for c in range(3):\n",
    "        F = np.fft.fftshift(np.fft.fft2(out[:, :, c]))\n",
    "        mag = np.abs(F)\n",
    "        F[mag > (mag.mean() + sigma * mag.std())] *= suppress\n",
    "        out[:, :, c] = np.real(np.fft.ifft2(np.fft.ifftshift(F)))\n",
    "    return np.clip(out, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def guided_denoise(img, radius=8, eps=0.02):\n",
    "    try:\n",
    "        f = img.astype(np.float32) / 255.0\n",
    "        r = np.stack([cv2.ximgproc.guidedFilter(f, f[:,:,c], radius, eps)\n",
    "                      for c in range(3)], axis=2)\n",
    "        return (np.clip(r, 0, 1)*255).astype(np.uint8)\n",
    "    except AttributeError:\n",
    "        return cv2.GaussianBlur(img, (5, 5), 0)\n",
    "\n",
    "\n",
    "def suppress_artifacts(img, artifact_map, pres_mask, denoise_strength=1.0):\n",
    "    h = max(3, int(10 * denoise_strength))\n",
    "    print('  NLM',        end=' ... ', flush=True); nlm  = nlm_denoise(img, h, h);         print('ok')\n",
    "    print('  bilateral',  end=' ... ', flush=True); bil  = bilateral_denoise(img, denoise_strength); print('ok')\n",
    "    print('  wavelet',    end=' ... ', flush=True); wav  = wavelet_denoise(img);            print('ok')\n",
    "    print('  FFT cleanup',end=' ... ', flush=True); freq = frequency_cleanup(img);          print('ok')\n",
    "    print('  guided',     end=' ... ', flush=True); guid = guided_denoise(img);             print('ok')\n",
    "    ens = (0.30*nlm.astype(np.float32) + 0.20*bil.astype(np.float32) +\n",
    "           0.25*wav.astype(np.float32) + 0.15*freq.astype(np.float32) +\n",
    "           0.10*guid.astype(np.float32))\n",
    "    w = np.clip(artifact_map * (1.0 - pres_mask), 0, 1)[:, :, np.newaxis]\n",
    "    return np.clip(img.astype(np.float32) * (1-w) + ens * w, 0, 255).astype(np.uint8)\n",
    "\n",
    "print('Stage 3 loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c-s4-md",
   "metadata": {},
   "source": [
    "## Stage 4 - AI Restoration\n",
    "Weights auto-downloaded and cached in `/content/ai_models/`. Tile-based inference keeps VRAM usage bounded.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-stage4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STAGE 4 - AI Restoration\n",
    "import urllib.request\n",
    "\n",
    "URLS = {\n",
    "    'realesrgan_general': ('https://github.com/xinntao/Real-ESRGAN/releases/download/'\n",
    "                           'v0.1.0/RealESRGAN_x4plus.pth'),\n",
    "    'realesrgan_anime':   ('https://github.com/xinntao/Real-ESRGAN/releases/download/'\n",
    "                           'v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth'),\n",
    "    'swinir':             ('https://github.com/JingyunLiang/SwinIR/releases/download/v0.0/'\n",
    "                           '003_realSR_BSRGAN_DFO_s64w8_SwinIR-M_x4_GAN.pth'),\n",
    "}\n",
    "\n",
    "def _dl(key):\n",
    "    url  = URLS[key]\n",
    "    dest = os.path.join(MODELS_DIR, os.path.basename(url))\n",
    "    if not os.path.exists(dest):\n",
    "        print('  Downloading', os.path.basename(dest), '...')\n",
    "        urllib.request.urlretrieve(url, dest)\n",
    "    else:\n",
    "        print('  Cached:', os.path.basename(dest))\n",
    "    return dest\n",
    "\n",
    "\n",
    "def _blend(proc, orig, s):\n",
    "    if proc.shape != orig.shape:\n",
    "        proc = cv2.resize(proc, (orig.shape[1], orig.shape[0]),\n",
    "                          interpolation=cv2.INTER_LANCZOS4)\n",
    "    return np.clip(orig.astype(np.float32)*(1-s) +\n",
    "                   proc.astype(np.float32)*s, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def restore_realesrgan(img, variant='general', tile=512, strength=0.8):\n",
    "    try:\n",
    "        from realesrgan import RealESRGANer\n",
    "        from basicsr.archs.rrdbnet_arch import RRDBNet\n",
    "        key = 'realesrgan_' + variant\n",
    "        mp  = _dl(key)\n",
    "        nb  = 6 if variant == 'anime' else 23\n",
    "        mdl = RRDBNet(num_in_ch=3, num_out_ch=3, num_feat=64,\n",
    "                      num_block=nb, num_grow_ch=32, scale=4)\n",
    "        up  = RealESRGANer(scale=4, model_path=mp, model=mdl,\n",
    "                            tile=tile, tile_pad=10, pre_pad=0,\n",
    "                            half=(DEVICE=='cuda'), device=DEVICE)\n",
    "        out, _ = up.enhance(img, outscale=1)\n",
    "        return _blend(out, img, strength)\n",
    "    except Exception as e:\n",
    "        print('  RealESRGAN failed:', e)\n",
    "        return img\n",
    "\n",
    "\n",
    "def restore_swinir(img, tile=256, strength=0.8):\n",
    "    try:\n",
    "        sd = '/content/SwinIR'\n",
    "        if not os.path.isdir(sd):\n",
    "            print('  Cloning SwinIR...')\n",
    "            os.system('git clone -q https://github.com/JingyunLiang/SwinIR.git ' + sd)\n",
    "        if sd not in sys.path:\n",
    "            sys.path.insert(0, sd)\n",
    "        mp = _dl('swinir')\n",
    "        from models.network_swinir import SwinIR\n",
    "        net = SwinIR(upscale=4, in_chans=3, img_size=64, window_size=8,\n",
    "                     img_range=1.0, depths=[6]*6, embed_dim=180, num_heads=[6]*6,\n",
    "                     mlp_ratio=2, upsampler='nearest+conv', resi_connection='1conv')\n",
    "        ck = torch.load(mp, map_location=DEVICE)\n",
    "        net.load_state_dict(ck['params_ema'], strict=True)\n",
    "        net.eval().to(DEVICE)\n",
    "        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "        t   = torch.from_numpy(rgb).float().permute(2,0,1).unsqueeze(0)/255.0\n",
    "        with torch.no_grad():\n",
    "            b, c, h, w = t.shape\n",
    "            pad = 32; stride = tile - pad\n",
    "            HL = list(range(0, h-tile, stride)) + [h-tile]\n",
    "            WL = list(range(0, w-tile, stride)) + [w-tile]\n",
    "            E  = torch.zeros(b, c, h*4, w*4).to(DEVICE)\n",
    "            W2 = torch.zeros_like(E)\n",
    "            for hi in HL:\n",
    "                for wi in WL:\n",
    "                    p  = t[:, :, hi:hi+tile, wi:wi+tile].to(DEVICE)\n",
    "                    o  = net(p)\n",
    "                    E[:, :, hi*4:(hi+tile)*4, wi*4:(wi+tile)*4].add_(o)\n",
    "                    W2[:,:, hi*4:(hi+tile)*4, wi*4:(wi+tile)*4].add_(torch.ones_like(o))\n",
    "            out_t = E.div_(W2)\n",
    "        out_np = (np.clip(out_t.squeeze().permute(1,2,0).cpu().numpy(),0,1)*255).astype(np.uint8)\n",
    "        out_bgr = cv2.resize(cv2.cvtColor(out_np, cv2.COLOR_RGB2BGR),\n",
    "                              (img.shape[1], img.shape[0]),\n",
    "                              interpolation=cv2.INTER_LANCZOS4)\n",
    "        return _blend(out_bgr, img, strength)\n",
    "    except Exception as e:\n",
    "        print('  SwinIR failed:', e)\n",
    "        return img\n",
    "\n",
    "\n",
    "def restore_image(img, model_type='realesrgan_general', strength=0.8, tile=512):\n",
    "    if model_type == 'none':\n",
    "        print('  AI restoration skipped.'); return img\n",
    "    elif model_type == 'realesrgan_general':\n",
    "        return restore_realesrgan(img, 'general', tile, strength)\n",
    "    elif model_type == 'realesrgan_anime':\n",
    "        return restore_realesrgan(img, 'anime',   tile, strength)\n",
    "    elif model_type == 'swinir':\n",
    "        return restore_swinir(img, tile, strength)\n",
    "    else:\n",
    "        print('  Unknown model, skipping.'); return img\n",
    "\n",
    "print('Stage 4 loaded.')\n"
   ]
