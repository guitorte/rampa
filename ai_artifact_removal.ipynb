   "source": [
    "## Stage 1 - Artifact Detection\n",
    "Six complementary analysis methods are fused into a single artifact probability map.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-stage1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# STAGE 1 - Artifact Detection Functions\n",
    "# ============================================================\n",
    "\n",
    "def _normalize(arr: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Normalize array to [0, 1].\"\"\"\n",
    "    mn, mx = arr.min(), arr.max()\n",
    "    if mx - mn < 1e-8:\n",
    "        return np.zeros_like(arr, dtype=np.float32)\n",
    "    return ((arr - mn) / (mx - mn)).astype(np.float32)\n",
    "\n",
    "\n",
    "def compute_edge_density_map(gray: np.ndarray, win: int = 16) -> np.ndarray:\n",
    "    \"\"\"Local Canny-edge density - highlights ringing and over-sharpened regions.\"\"\"\n",
    "    edges = cv2.Canny(gray, 50, 150).astype(np.float32)\n",
    "    k = np.ones((win, win), np.float32) / (win * win)\n",
    "    density = cv2.filter2D(edges, -1, k)\n",
    "    return _normalize(density)\n",
    "\n",
    "\n",
    "def compute_fft_artifact_map(gray: np.ndarray, threshold_sigma: float = 2.5) -> np.ndarray:\n",
    "    \"\"\"FFT-based detection of periodic / checkerboard patterns.\"\"\"\n",
    "    f = np.fft.fft2(gray.astype(np.float64))\n",
    "    fshift = np.fft.fftshift(f)\n",
    "    mag = np.log1p(np.abs(fshift))\n",
    "\n",
    "    # Mask anomalous frequency peaks\n",
    "    anomaly_mask = mag > (mag.mean() + threshold_sigma * mag.std())\n",
    "\n",
    "    # Block DC component (center 5% of image) - not an artifact\n",
    "    h, w = gray.shape\n",
    "    cy, cx = h // 2, w // 2\n",
    "    r = min(h, w) // 20\n",
    "    anomaly_mask[cy - r: cy + r, cx - r: cx + r] = False\n",
    "\n",
    "    fshift_filtered = np.zeros_like(fshift)\n",
    "    fshift_filtered[anomaly_mask] = fshift[anomaly_mask]\n",
    "    spatial = np.abs(np.fft.ifft2(np.fft.ifftshift(fshift_filtered)))\n",
    "    spatial_resized = cv2.resize(spatial.astype(np.float32), (w, h))\n",
    "    return _normalize(spatial_resized)\n",
    "\n",
    "\n",
    "def compute_entropy_map(gray: np.ndarray, radius: int = 5) -> np.ndarray:\n",
    "    \"\"\"Local Shannon entropy - noisy / artifact-rich patches have high entropy.\"\"\"\n",
    "    from skimage.filters.rank import entropy as skentropy\n",
    "    from skimage.morphology import disk\n",
    "    ent = skentropy(gray.astype(np.uint8), disk(radius)).astype(np.float32)\n",
    "    return _normalize(ent)\n",
    "\n",
    "\n",
    "def compute_laplacian_var_map(gray: np.ndarray, win: int = 16) -> np.ndarray:\n",
    "    \"\"\"Local Laplacian variance - high values indicate ringing / over-sharpening.\"\"\"\n",
    "    lap = cv2.Laplacian(gray.astype(np.float32), cv2.CV_32F)\n",
    "    lap_sq = lap ** 2\n",
    "    k = np.ones((win, win), np.float32) / (win * win)\n",
    "    local_var = cv2.filter2D(lap_sq, -1, k)\n",
    "    return _normalize(local_var)\n",
    "\n",
    "\n",
    "def compute_wavelet_artifact_map(gray: np.ndarray, wavelet: str = 'db4',\n",
    "                                  levels: int = 3) -> np.ndarray:\n",
    "    \"\"\"Wavelet detail-coefficient outliers reveal high-frequency artifacts.\"\"\"\n",
    "    img_f = gray.astype(np.float64) / 255.0\n",
    "    coeffs = pywt.wavedec2(img_f, wavelet, level=levels)\n",
    "    h, w = gray.shape\n",
    "    acc = np.zeros((h, w), np.float32)\n",
    "    for level_tuple in coeffs[1:]:  # skip approximation\n",
    "        for detail in level_tuple:\n",
    "            d_abs = np.abs(detail).astype(np.float32)\n",
    "            d_up = cv2.resize(d_abs, (w, h))\n",
    "            mu, sigma = d_up.mean(), d_up.std() + 1e-8\n",
    "            anomaly = np.clip((d_up - (mu + 2 * sigma)) / sigma, 0, None)\n",
    "            acc += anomaly\n",
    "    return _normalize(acc)\n",
    "\n",
    "\n",
    "def compute_repetition_map(gray: np.ndarray, exclude_radius: int = 16) -> np.ndarray:\n",
    "    \"\"\"Autocorrelation off-peak energy - detects tiled / repeated micro-patterns.\"\"\"\n",
    "    g = gray.astype(np.float64)\n",
    "    ps = np.abs(np.fft.fft2(g)) ** 2\n",
    "    ac = np.real(np.fft.ifft2(ps))\n",
    "    ac = np.fft.fftshift(ac)\n",
    "    h, w = ac.shape\n",
    "    cy, cx = h // 2, w // 2\n",
    "    r = exclude_radius\n",
    "    ac[cy - r: cy + r, cx - r: cx + r] = 0\n",
    "    ac_resized = cv2.resize(np.abs(ac).astype(np.float32), (w, h))\n",
    "    return _normalize(ac_resized)\n",
    "\n",
    "\n",
    "def generate_artifact_map(img_bgr: np.ndarray,\n",
    "                           strength: float = 1.0) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Fuse all detection methods into one artifact probability map.\n",
    "    Returns float32 array in [0, 1], same spatial size as input.\n",
    "    \"\"\"\n",
    "    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)\n",
    "    h, w = gray.shape\n",
    "\n",
    "    print('  [1/6] Edge density...', end=' ', flush=True)\n",
    "    m_edge = compute_edge_density_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    print('  [2/6] FFT periodicity...', end=' ', flush=True)\n",
    "    m_fft  = compute_fft_artifact_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    print('  [3/6] Local entropy...', end=' ', flush=True)\n",
    "    m_ent  = compute_entropy_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    print('  [4/6] Laplacian var...', end=' ', flush=True)\n",
    "    m_lap  = compute_laplacian_var_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    print('  [5/6] Wavelet detail...', end=' ', flush=True)\n",
    "    m_wav  = compute_wavelet_artifact_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    print('  [6/6] Repetition...', end=' ', flush=True)\n",
    "    m_rep  = compute_repetition_map(gray)\n",
    "    print('done')\n",
    "\n",
    "    fused = (0.15 * m_edge +\n",
    "             0.25 * m_fft  +\n",
    "             0.15 * m_ent  +\n",
    "             0.20 * m_lap  +\n",
    "             0.15 * m_wav  +\n",
    "             0.10 * m_rep)\n",
    "\n",
    "    fused = np.clip(fused * strength, 0, 1)\n",
    "    fused = cv2.GaussianBlur(fused, (25, 25), 0)\n",
    "    return _normalize(fused)\n",
    "\n",
    "\n",
    "print('Stage 1 functions loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-stage2-md",
   "metadata": {},
   "source": [
    "## Stage 2 - Structural Preservation\n",
    "Builds a mask that protects edges, contours, and high-gradient regions from over-processing.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-stage2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# STAGE 2 - Structural Preservation Functions\n",
    "# ============================================================\n",
    "\n",
    "def extract_major_edges(img_bgr: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Multi-scale Canny edge map, float32 in [0, 1].\"\"\"\n",
    "    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)\n",
    "    e1 = cv2.Canny(gray, 20,  80)\n",
    "    e2 = cv2.Canny(gray, 50, 150)\n",
    "    e3 = cv2.Canny(gray, 80, 200)\n",
    "    combined = cv2.bitwise_or(cv2.bitwise_or(e1, e2), e3)\n",
    "    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n",
    "    dilated = cv2.dilate(combined, kernel, iterations=2)\n",
    "    return (dilated.astype(np.float32) / 255.0)\n",
    "\n",
    "\n",
    "def extract_gradient_magnitude(img_bgr: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Sobel gradient magnitude, float32 in [0, 1].\"\"\"\n",
    "    gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "    gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)\n",
    "    gy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)\n",
    "    mag = np.sqrt(gx ** 2 + gy ** 2)\n",
    "    return _normalize(mag)\n",
    "\n",
    "\n",
    "def segment_color_regions(img_bgr: np.ndarray,\n",
    "                            n_clusters: int = 8) -> np.ndarray:\n",
    "    \"\"\"K-means color segmentation; returns label map (uint8).\"\"\"\n",
    "    h, w = img_bgr.shape[:2]\n",
    "    scale = min(1.0, 512 / max(h, w))\n",
    "    small = cv2.resize(img_bgr, (int(w * scale), int(h * scale)))\n",
    "    lab = cv2.cvtColor(small, cv2.COLOR_BGR2LAB)\n",
    "    pixels = lab.reshape(-1, 3).astype(np.float32)\n",
    "    criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 20, 0.5)\n",
    "    _, labels, _ = cv2.kmeans(pixels, n_clusters, None,\n",
    "                               criteria, 3, cv2.KMEANS_PP_CENTERS)\n",
    "    labels_img = labels.reshape(small.shape[:2]).astype(np.uint8)\n",
    "    return cv2.resize(labels_img, (w, h), interpolation=cv2.INTER_NEAREST)\n",
    "\n",
    "\n",
    "def build_preservation_mask(img_bgr: np.ndarray,\n",
    "                              edge_weight: float = 0.65) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Combine edge map and gradient magnitude into a single preservation mask.\n",
    "    Value near 1 = preserve / do not process.\n",
    "    Value near 0 = safe to apply artifact suppression.\n",
    "    \"\"\"\n",
    "    edges = extract_major_edges(img_bgr)\n",
    "    gradient = extract_gradient_magnitude(img_bgr)\n",
    "    mask = edge_weight * edges + (1.0 - edge_weight) * gradient\n",
    "    mask = np.clip(mask, 0, 1)\n",
    "    mask = cv2.GaussianBlur(mask, (15, 15), 0)\n",
    "    return mask.astype(np.float32)\n",
    "\n",
    "\n",
    "print('Stage 2 functions loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-stage3-md",
   "metadata": {},
   "source": [
    "## Stage 3 - Artifact Suppression\n",
    "Five classical filters are applied and blended; processing is weighted by the artifact map and constrained by the preservation mask.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-stage3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# STAGE 3 - Artifact Suppression Functions\n",
    "# ============================================================\n",
    "\n",
    "def nlm_denoise(img_bgr: np.ndarray, h_lum: int = 10,\n",
    "                 h_col: int = 10) -> np.ndarray:\n",
    "    \"\"\"Non-local means denoising - excellent against diffusion speckling.\"\"\"\n",
    "    return cv2.fastNlMeansDenoisingColored(\n",
    "        img_bgr, None,\n",
    "        h=h_lum, hColor=h_col,\n",
    "        templateWindowSize=7,\n",
    "        searchWindowSize=21\n",
    "    )\n",
    "\n",
    "\n",
    "def bilateral_denoise(img_bgr: np.ndarray,\n",
    "                       sigma: float = 1.0) -> np.ndarray:\n",
    "    \"\"\"Bilateral filter - edge-preserving smooth-out of flat artifact regions.\"\"\"\n",
    "    d = max(5, int(9 * sigma))\n",
    "    sc = int(75 * sigma)\n",
    "    ss = int(75 * sigma)\n",
    "    return cv2.bilateralFilter(img_bgr, d, sc, ss)\n",
    "\n",
    "\n",
    "def wavelet_denoise(img_bgr: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"BayesShrink wavelet denoising - removes worm-like and speckle artifacts.\"\"\"\n",
    "    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB).astype(np.float32) / 255.0\n",
    "    denoised = denoise_wavelet(\n",
    "        img_rgb,\n",
    "        method='BayesShrink',\n",
    "        mode='soft',\n",
    "        wavelet='db4',\n",
    "        wavelet_levels=3,\n",
    "        channel_axis=-1\n",
    "    )\n",
    "    result = (np.clip(denoised, 0, 1) * 255).astype(np.uint8)\n",
    "    return cv2.cvtColor(result, cv2.COLOR_RGB2BGR)\n",
    "\n",
    "\n",
    "def frequency_cleanup(img_bgr: np.ndarray,\n",
    "                       outlier_sigma: float = 3.0,\n",
    "                       suppress_factor: float = 0.15) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Suppress anomalous frequency peaks per channel.\n",
    "    Reduces checkerboard and periodic lattice artifacts.\n",
    "    \"\"\"\n",
    "    result = img_bgr.astype(np.float32)\n",
    "    for c in range(3):\n",
    "        ch = result[:, :, c]\n",
    "        F = np.fft.fft2(ch)\n",
    "        Fsh = np.fft.fftshift(F)\n",
    "        mag = np.abs(Fsh)\n",
    "        mu, sigma = mag.mean(), mag.std()\n",
    "        outliers = mag > (mu + outlier_sigma * sigma)\n",
    "        Fsh[outliers] *= suppress_factor\n",
    "        result[:, :, c] = np.real(np.fft.ifft2(np.fft.ifftshift(Fsh)))\n",
    "    return np.clip(result, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def guided_filter_denoise(img_bgr: np.ndarray,\n",
    "                            radius: int = 8,\n",
    "                            eps: float = 0.02) -> np.ndarray:\n",
    "    \"\"\"Guided filter - edge-aware smoothing using the image as its own guide.\"\"\"\n",
    "    try:\n",
    "        img_f = img_bgr.astype(np.float32) / 255.0\n",
    "        result = np.zeros_like(img_f)\n",
    "        for c in range(3):\n",
    "            result[:, :, c] = cv2.ximgproc.guidedFilter(\n",
    "                img_f, img_f[:, :, c], radius, eps\n",
    "            )\n",
    "        return (np.clip(result, 0, 1) * 255).astype(np.uint8)\n",
    "    except AttributeError:\n",
    "        return cv2.GaussianBlur(img_bgr, (5, 5), 0)\n",
    "\n",
    "\n",
    "def suppress_artifacts(\n",
    "    img_bgr: np.ndarray,\n",
    "    artifact_map: np.ndarray,\n",
    "    preservation_mask: np.ndarray,\n",
    "    denoise_strength: float = 1.0\n",
    ") -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Blend all suppression methods and composite over the input,\n",
    "    processing only where artifact_map is high and preservation_mask is low.\n",
    "    \"\"\"\n",
    "    h_param = max(3, int(10 * denoise_strength))\n",
    "\n",
    "    print('  Non-local means...', end=' ', flush=True)\n",
    "    nlm  = nlm_denoise(img_bgr, h_lum=h_param, h_col=h_param)\n",
    "    print('done')\n",
    "\n",
    "    print('  Bilateral...', end=' ', flush=True)\n",
    "    bil  = bilateral_denoise(img_bgr, sigma=denoise_strength)\n",
    "    print('done')\n",
    "\n",
    "    print('  Wavelet...', end=' ', flush=True)\n",
    "    wav  = wavelet_denoise(img_bgr)\n",
    "    print('done')\n",
    "\n",
    "    print('  Frequency cleanup...', end=' ', flush=True)\n",
    "    freq = frequency_cleanup(img_bgr)\n",
    "    print('done')\n",
    "\n",
    "    print('  Guided filter...', end=' ', flush=True)\n",
    "    guid = guided_filter_denoise(img_bgr)\n",
    "    print('done')\n",
    "\n",
    "    nlm_f  = nlm.astype(np.float32)\n",
    "    bil_f  = bil.astype(np.float32)\n",
    "    wav_f  = wav.astype(np.float32)\n",
    "    freq_f = freq.astype(np.float32)\n",
    "    guid_f = guid.astype(np.float32)\n",
    "\n",
    "    ensemble = (0.30 * nlm_f  +\n",
    "                0.20 * bil_f  +\n",
    "                0.25 * wav_f  +\n",
    "                0.15 * freq_f +\n",
    "                0.10 * guid_f)\n",
    "\n",
    "    w = (artifact_map * (1.0 - preservation_mask))[:, :, np.newaxis]\n",
    "    w = np.clip(w, 0, 1)\n",
    "\n",
    "    result = img_bgr.astype(np.float32) * (1.0 - w) + ensemble * w\n",
    "    return np.clip(result, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "print('Stage 3 functions loaded.')\n"
   ]
  },
