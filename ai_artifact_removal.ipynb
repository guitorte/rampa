   "cell_type": "markdown",
   "id": "cell-stage4-md",
   "metadata": {},
   "source": [
    "## Stage 4 - AI Restoration\n",
    "Downloads and runs RealESRGAN or SwinIR (GPU-accelerated). Model weights are cached in `/content/ai_models/`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-stage4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# STAGE 4 - AI Restoration Functions\n",
    "# ============================================================\n",
    "import urllib.request\n",
    "\n",
    "REALESRGAN_GENERAL_URL = (\n",
    "    'https://github.com/xinntao/Real-ESRGAN/releases/download/'\n",
    "    'v0.1.0/RealESRGAN_x4plus.pth'\n",
    ")\n",
    "REALESRGAN_ANIME_URL = (\n",
    "    'https://github.com/xinntao/Real-ESRGAN/releases/download/'\n",
    "    'v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth'\n",
    ")\n",
    "SWINIR_URL = (\n",
    "    'https://github.com/JingyunLiang/SwinIR/releases/download/v0.0/'\n",
    "    '003_realSR_BSRGAN_DFO_s64w8_SwinIR-M_x4_GAN.pth'\n",
    ")\n",
    "\n",
    "\n",
    "def _download(url: str, dest: str) -> str:\n",
    "    \"\"\"Download url to dest if not already present; return dest path.\"\"\"\n",
    "    if not os.path.exists(dest):\n",
    "        print(f'  Downloading {os.path.basename(dest)} ...')\n",
    "        os.makedirs(os.path.dirname(dest), exist_ok=True)\n",
    "        urllib.request.urlretrieve(url, dest)\n",
    "        print(f'  Saved to {dest}')\n",
    "    else:\n",
    "        print(f'  Using cached model: {os.path.basename(dest)}')\n",
    "    return dest\n",
    "\n",
    "\n",
    "def _blend_with_original(processed: np.ndarray, original: np.ndarray,\n",
    "                           strength: float) -> np.ndarray:\n",
    "    \"\"\"Blend processed and original by restoration_strength.\"\"\"\n",
    "    if processed.shape != original.shape:\n",
    "        processed = cv2.resize(processed,\n",
    "                                (original.shape[1], original.shape[0]),\n",
    "                                interpolation=cv2.INTER_LANCZOS4)\n",
    "    out = original.astype(np.float32) * (1.0 - strength) + processed.astype(np.float32) * strength\n",
    "    return np.clip(out, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def restore_realesrgan(img_bgr: np.ndarray,\n",
    "                        model_variant: str = 'general',\n",
    "                        tile: int = 512,\n",
    "                        restoration_strength: float = 0.8) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    RealESRGAN restoration.\n",
    "    model_variant: 'general' (photo-realistic) | 'anime' (illustration)\n",
    "    \"\"\"\n",
    "    try:\n",
    "        from realesrgan import RealESRGANer\n",
    "        from basicsr.archs.rrdbnet_arch import RRDBNet\n",
    "\n",
    "        if model_variant == 'anime':\n",
    "            mp = _download(REALESRGAN_ANIME_URL,\n",
    "                           os.path.join(MODELS_DIR, 'RealESRGAN_x4plus_anime_6B.pth'))\n",
    "            model = RRDBNet(num_in_ch=3, num_out_ch=3, num_feat=64,\n",
    "                            num_block=6, num_grow_ch=32, scale=4)\n",
    "        else:\n",
    "            mp = _download(REALESRGAN_GENERAL_URL,\n",
    "                           os.path.join(MODELS_DIR, 'RealESRGAN_x4plus.pth'))\n",
    "            model = RRDBNet(num_in_ch=3, num_out_ch=3, num_feat=64,\n",
    "                            num_block=23, num_grow_ch=32, scale=4)\n",
    "\n",
    "        upsampler = RealESRGANer(\n",
    "            scale=4, model_path=mp, model=model,\n",
    "            tile=tile, tile_pad=10, pre_pad=0,\n",
    "            half=(DEVICE == 'cuda'), device=DEVICE\n",
    "        )\n",
    "\n",
    "        output, _ = upsampler.enhance(img_bgr, outscale=1)\n",
    "        return _blend_with_original(output, img_bgr, restoration_strength)\n",
    "\n",
    "    except Exception as exc:\n",
    "        print(f'  RealESRGAN failed ({exc}), returning input unchanged.')\n",
    "        return img_bgr\n",
    "\n",
    "\n",
    "def restore_swinir(img_bgr: np.ndarray,\n",
    "                    tile: int = 256,\n",
    "                    restoration_strength: float = 0.8) -> np.ndarray:\n",
    "    \"\"\"SwinIR restoration (real-world super-resolution for noise removal).\"\"\"\n",
    "    try:\n",
    "        swinir_dir = '/content/SwinIR'\n",
    "        if not os.path.isdir(swinir_dir):\n",
    "            print('  Cloning SwinIR...')\n",
    "            os.system('git clone -q https://github.com/JingyunLiang/SwinIR.git /content/SwinIR')\n",
    "        if swinir_dir not in sys.path:\n",
    "            sys.path.insert(0, swinir_dir)\n",
    "\n",
    "        mp = _download(SWINIR_URL, os.path.join(\n",
    "            MODELS_DIR, '003_realSR_BSRGAN_DFO_s64w8_SwinIR-M_x4_GAN.pth'))\n",
    "\n",
    "        from models.network_swinir import SwinIR\n",
    "        net = SwinIR(\n",
    "            upscale=4, in_chans=3, img_size=64, window_size=8,\n",
    "            img_range=1.0, depths=[6]*6, embed_dim=180,\n",
    "            num_heads=[6]*6, mlp_ratio=2,\n",
    "            upsampler='nearest+conv', resi_connection='1conv'\n",
    "        )\n",
    "        ckpt = torch.load(mp, map_location=DEVICE)\n",
    "        net.load_state_dict(ckpt['params_ema'], strict=True)\n",
    "        net.eval().to(DEVICE)\n",
    "\n",
    "        img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "        t = torch.from_numpy(img_rgb).float().permute(2, 0, 1).unsqueeze(0) / 255.0\n",
    "\n",
    "        with torch.no_grad():\n",
    "            b, c, h, w = t.shape\n",
    "            tile_pad = 32\n",
    "            stride   = tile - tile_pad\n",
    "            h_list   = list(range(0, h - tile, stride)) + [h - tile]\n",
    "            w_list   = list(range(0, w - tile, stride)) + [w - tile]\n",
    "            E = torch.zeros(b, c, h * 4, w * 4).to(DEVICE)\n",
    "            W = torch.zeros_like(E)\n",
    "            for hi in h_list:\n",
    "                for wi in w_list:\n",
    "                    patch = t[:, :, hi:hi + tile, wi:wi + tile].to(DEVICE)\n",
    "                    out   = net(patch)\n",
    "                    E[:, :, hi*4:(hi+tile)*4, wi*4:(wi+tile)*4].add_(out)\n",
    "                    W[:, :, hi*4:(hi+tile)*4, wi*4:(wi+tile)*4].add_(torch.ones_like(out))\n",
    "            output_t = E.div_(W)\n",
    "\n",
    "        out_np = output_t.squeeze().permute(1, 2, 0).cpu().numpy()\n",
    "        out_np = (np.clip(out_np, 0, 1) * 255).astype(np.uint8)\n",
    "        out_bgr = cv2.cvtColor(out_np, cv2.COLOR_RGB2BGR)\n",
    "        out_bgr = cv2.resize(out_bgr, (img_bgr.shape[1], img_bgr.shape[0]),\n",
    "                              interpolation=cv2.INTER_LANCZOS4)\n",
    "        return _blend_with_original(out_bgr, img_bgr, restoration_strength)\n",
    "\n",
    "    except Exception as exc:\n",
    "        print(f'  SwinIR failed ({exc}), returning input unchanged.')\n",
    "        return img_bgr\n",
    "\n",
    "\n",
    "def restore_image(img_bgr: np.ndarray,\n",
    "                   model_type: str = 'realesrgan_general',\n",
    "                   restoration_strength: float = 0.8,\n",
    "                   tile_size: int = 512) -> np.ndarray:\n",
    "    \"\"\"Dispatch to the selected restoration model.\"\"\"\n",
    "    if model_type == 'none':\n",
    "        print('  AI restoration skipped.')\n",
    "        return img_bgr\n",
    "    elif model_type == 'realesrgan_general':\n",
    "        return restore_realesrgan(img_bgr, 'general', tile_size, restoration_strength)\n",
    "    elif model_type == 'realesrgan_anime':\n",
    "        return restore_realesrgan(img_bgr, 'anime', tile_size, restoration_strength)\n",
    "    elif model_type == 'swinir':\n",
    "        return restore_swinir(img_bgr, tile_size, restoration_strength)\n",
    "    else:\n",
    "        print(f'  Unknown model: {model_type}. Skipping.')\n",
    "        return img_bgr\n",
    "\n",
    "\n",
    "print('Stage 4 functions loaded.')\n"
   ]
  },
