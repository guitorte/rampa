   "outputs": [],
   "source": [
    "# INTERACTIVE UI - ipywidgets + HTML/JS before-after slider\n",
    "\n",
    "_ST = {'orig': None, 'result': None, 'amap': None, 'path': None}\n",
    "\n",
    "\n",
    "def _b64(img, q=88):\n",
    "    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "    buf = io.BytesIO()\n",
    "    PILImage.fromarray(rgb).save(buf, format='JPEG', quality=q)\n",
    "    return base64.b64encode(buf.getvalue()).decode()\n",
    "\n",
    "\n",
    "def _slider_html(orig, result, max_w=820):\n",
    "    h, w = orig.shape[:2]\n",
    "    sc = min(1.0, max_w / w)\n",
    "    dw, dh = int(w*sc), int(h*sc)\n",
    "    ob = _b64(cv2.resize(orig,   (dw, dh)))\n",
    "    rb = _b64(cv2.resize(result, (dw, dh)))\n",
    "    sdw, sdh = str(dw), str(dh)\n",
    "    shalf = str(dw//2)\n",
    "    stop  = str(dh//2 - 22)\n",
    "    sleft = str(dw//2 - 22)\n",
    "    css = (\n",
    "        '<style>'\n",
    "        '.cw{position:relative;width:'+sdw+'px;height:'+sdh+'px;'\n",
    "        'border:2px solid #444;overflow:hidden;cursor:col-resize;'\n",
    "        'user-select:none;border-radius:6px}'\n",
    "        '.cw img{position:absolute;top:0;left:0;'\n",
    "        'width:'+sdw+'px;height:'+sdh+'px}'\n",
    "        '.cc{position:absolute;top:0;left:0;'\n",
    "        'width:'+shalf+'px;height:'+sdh+'px;overflow:hidden}'\n",
    "        '.cd{position:absolute;top:0;left:'+str(dw//2-1)+'px;'\n",
    "        'width:3px;height:'+sdh+'px;'\n",
    "        'background:rgba(255,255,255,.9)}'\n",
    "        '.ch{position:absolute;top:'+stop+'px;left:'+sleft+'px;'\n",
    "        'width:44px;height:44px;border-radius:50%;'\n",
    "        'background:white;border:2px solid #333;'\n",
    "        'display:flex;align-items:center;justify-content:center;'\n",
    "        'font-size:18px;color:#333}'\n",
    "        '.lb{position:absolute;top:8px;padding:3px 9px;'\n",
    "        'border-radius:4px;font:bold 12px sans-serif;color:#fff}'\n",
    "        '.lb-b{left:8px;background:rgba(0,0,0,.6)}'\n",
    "        '.lb-a{right:8px;background:rgba(0,120,0,.7)}'\n",
    "        '</style>'\n",
    "    )\n",
    "    body = (\n",
    "        '<p style=\"font:bold 14px sans-serif;margin:8px 0\">'\n",
    "        'Drag to compare BEFORE / AFTER</p>'\n",
    "        '<div class=\"cw\" id=\"cmpW\">'\n",
    "        '<img src=\"data:image/jpeg;base64,'+rb+'\" />'\n",
    "        '<div class=\"cc\" id=\"cmpC\">'\n",
    "        '<img src=\"data:image/jpeg;base64,'+ob+'\" />'\n",
    "        '</div>'\n",
    "        '<div class=\"cd\" id=\"cmpD\"></div>'\n",
    "        '<div class=\"ch\" id=\"cmpH\">&#8596;</div>'\n",
    "        '<span class=\"lb lb-b\">BEFORE</span>'\n",
    "        '<span class=\"lb lb-a\">AFTER</span>'\n",
    "        '</div>'\n",
    "    )\n",
    "    js = (\n",
    "        '<script>(function(){'\n",
    "        'var W='+sdw+',drag=false;'\n",
    "        'var wp=document.getElementById(\"cmpW\");'\n",
    "        'var cp=document.getElementById(\"cmpC\");'\n",
    "        'var dv=document.getElementById(\"cmpD\");'\n",
    "        'var hd=document.getElementById(\"cmpH\");'\n",
    "        'function p(x){x=Math.max(0,Math.min(W,x));'\n",
    "        'cp.style.width=x+\"px\";'\n",
    "        'dv.style.left=(x-1)+\"px\";'\n",
    "        'hd.style.left=(x-22)+\"px\";}' \n",
    "        'wp.addEventListener(\"mousedown\",function(e){drag=true;e.preventDefault();});'\n",
    "        'document.addEventListener(\"mousemove\",function(e){'\n",
    "        'if(!drag)return;'\n",
    "        'p(e.clientX-wp.getBoundingClientRect().left);});'\n",
    "        'document.addEventListener(\"mouseup\",function(){drag=false;});'\n",
    "        'wp.addEventListener(\"touchstart\",function(e){drag=true;e.preventDefault();});'\n",
    "        'document.addEventListener(\"touchmove\",function(e){'\n",
    "        'if(!drag)return;'\n",
    "        'p(e.touches[0].clientX-wp.getBoundingClientRect().left);});'\n",
    "        'document.addEventListener(\"touchend\",function(){drag=false;});'\n",
    "        '})();</script>'\n",
    "    )\n",
    "    return css + body + js\n",
    "\n",
    "\n",
    "def _show_maps():\n",
    "    fig, ax = plt.subplots(1, 3, figsize=(14, 4))\n",
    "    ax[0].imshow(cv2.cvtColor(_ST['orig'],   cv2.COLOR_BGR2RGB))\n",
    "    ax[0].set_title('Original'); ax[0].axis('off')\n",
    "    im = ax[1].imshow(_ST['amap'], cmap='hot', vmin=0, vmax=1)\n",
    "    ax[1].set_title('Artifact Map'); ax[1].axis('off')\n",
    "    plt.colorbar(im, ax=ax[1], fraction=0.046)\n",
    "    ax[2].imshow(cv2.cvtColor(_ST['result'], cv2.COLOR_BGR2RGB))\n",
    "    ax[2].set_title('Cleaned'); ax[2].axis('off')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "# Widgets\n",
    "fopts = ([(os.path.basename(f), f) for f in ARTWORK_FILES]\n",
    "         if ARTWORK_FILES else [('(no images)', None)])\n",
    "w_file = widgets.Dropdown(options=fopts, description='Image:',\n",
    "                           layout=widgets.Layout(width='90%'),\n",
    "                           style={'description_width':'80px'})\n",
    "skw = dict(style={'description_width':'initial'},\n",
    "            layout=widgets.Layout(width='90%'))\n",
    "w_art  = widgets.FloatSlider(value=1.0, min=0.1, max=2.0, step=0.1,\n",
    "             description='Artifact detection strength:', **skw)\n",
    "w_den  = widgets.FloatSlider(value=1.0, min=0.1, max=2.0, step=0.1,\n",
    "             description='Denoising strength:', **skw)\n",
    "w_res  = widgets.FloatSlider(value=0.7, min=0.0, max=1.0, step=0.05,\n",
    "             description='Restoration blend:', **skw)\n",
    "w_mdl  = widgets.RadioButtons(\n",
    "    options=[\n",
    "        ('RealESRGAN General (photos)',       'realesrgan_general'),\n",
    "        ('RealESRGAN Anime (illustrations)',  'realesrgan_anime'),\n",
    "        ('SwinIR (transformer, slower)',      'swinir'),\n",
    "        ('None - classical pipeline only',    'none'),\n",
    "    ],\n",
    "    value='realesrgan_general', description='Model:',\n",
    "    style={'description_width':'80px'},\n",
    "    layout=widgets.Layout(width='90%'))\n",
    "w_tile = widgets.IntSlider(value=512, min=128, max=1024, step=128,\n",
    "             description='Tile size (less = lower VRAM):', **skw)\n",
    "w_map  = widgets.Checkbox(value=True,\n",
    "             description='Show artifact map + 3-way preview')\n",
    "w_run  = widgets.Button(description='Run Artifact Removal',\n",
    "             button_style='primary', icon='magic',\n",
    "             layout=widgets.Layout(width='250px', height='44px'))\n",
    "w_save = widgets.Button(description='Save to Drive',\n",
    "             button_style='success', icon='download',\n",
    "             layout=widgets.Layout(width='250px', height='44px'),\n",
    "             disabled=True)\n",
    "w_lbl  = widgets.Label(value='Ready - select an image and press Run.')\n",
    "w_out  = widgets.Output()\n",
    "\n",
    "\n",
    "def _run(b):\n",
    "    with w_out:\n",
    "        clear_output(wait=True)\n",
    "        fp = w_file.value\n",
    "        if fp is None:\n",
    "            print('No image.'); return\n",
    "        w_lbl.value = 'Loading...'\n",
    "        img = cv2.imread(fp, cv2.IMREAD_COLOR)\n",
    "        if img is None:\n",
    "            print('Cannot read:', fp); return\n",
    "        h, w = img.shape[:2]\n",
    "        print(os.path.basename(fp), '-', w, 'x', h, 'px')\n",
    "        _ST['orig'] = img.copy(); _ST['path'] = fp\n",
    "        w_lbl.value = 'Running pipeline...'\n",
    "        print('='*60)\n",
    "        res, amap = run_pipeline(\n",
    "            img, artifact_strength=w_art.value, denoise_strength=w_den.value,\n",
    "            restoration_strength=w_res.value, restoration_model=w_mdl.value,\n",
    "            tile_size=w_tile.value)\n",
    "        print('='*60)\n",
    "        _ST['result'] = res; _ST['amap'] = amap\n",
    "        if w_map.value:\n",
    "            _show_maps()\n",
    "        display(HTML(_slider_html(img, res)))\n",
    "        w_save.disabled = False\n",
    "        w_lbl.value = 'Done - press Save to export to Drive.'\n",
    "\n",
    "\n",
    "def _save(b):\n",
    "    with w_out:\n",
    "        if _ST['result'] is None:\n",
    "            print('Nothing to save.'); return\n",
    "        nm, ex = os.path.splitext(os.path.basename(_ST['path']))\n",
    "        pi = os.path.join(OUTPUT_DIR, nm + '_cleaned' + ex)\n",
    "        pm = os.path.join(OUTPUT_DIR, nm + '_artifact_map.png')\n",
    "        cv2.imwrite(pi, _ST['result'])\n",
    "        cv2.imwrite(pm, cv2.applyColorMap(\n",
    "            (_ST['amap']*255).astype(np.uint8), cv2.COLORMAP_HOT))\n",
    "        print('Saved:')\n",
    "        print(' ', pi)\n",
    "        print(' ', pm)\n",
    "        w_lbl.value = 'Saved to ' + OUTPUT_DIR\n",
    "\n",
    "\n",
    "w_run.on_click(_run)\n",
    "w_save.on_click(_save)\n",
    "\n",
    "header = widgets.HTML(\n",
    "    '<div style=\"background:linear-gradient(135deg,#12172a,#1c2e4a);'\n",
    "    'color:#f0f4ff;padding:18px 22px;border-radius:10px;\">'\
",
    "    '<h2 style=\"margin:0;font-size:20px;\">AI Artifact Removal Pipeline</h2>'\n",
    "    '<p style=\"margin:6px 0 0;opacity:.75;font-size:12px;\">'\
",
    "    'Detection > Preservation > Suppression > AI Restoration > Refinement'\n",
    "    '</p></div>'\n",
    ")\n",
    "panel = widgets.VBox([\n",
    "    header,\n",
    "    widgets.HTML('<b>Select image from /artwork</b>'),\n",
    "    w_file,\n",
    "    widgets.HTML('<hr><b>Pipeline parameters</b>'),\n",
    "    w_art, w_den, w_res,\n",
    "    widgets.HTML('<b>Restoration model</b>'),\n",
    "    w_mdl, w_tile, w_map,\n",
    "    widgets.HTML('<hr>'),\n",
    "    widgets.HBox([w_run, widgets.HTML('&nbsp;&nbsp;'), w_save]),\n",
    "    w_lbl,\n",
    "], layout=widgets.Layout(padding='12px'))\n",
    "display(panel, w_out)\n"
