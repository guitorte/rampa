  {
   "cell_type": "markdown",
   "id": "c-s5-md",
   "metadata": {},
   "source": [
    "## Stage 5 - Consistency Refinement\n",
    "LAB color match, HF texture re-injection, CLAHE, edge stabilization, and a fidelity blend back to the original.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-stage5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STAGE 5 - Consistency Refinement\n",
    "\n",
    "def color_match(proc, ref):\n",
    "    pl = cv2.cvtColor(proc, cv2.COLOR_BGR2LAB).astype(np.float32)\n",
    "    rl = cv2.cvtColor(ref,  cv2.COLOR_BGR2LAB).astype(np.float32)\n",
    "    out = np.zeros_like(pl)\n",
    "    for c in range(3):\n",
    "        pm, ps = pl[:,:,c].mean(), pl[:,:,c].std() + 1e-8\n",
    "        rm, rs = rl[:,:,c].mean(), rl[:,:,c].std() + 1e-8\n",
    "        out[:,:,c] = (pl[:,:,c] - pm) * (rs/ps) + rm\n",
    "    return cv2.cvtColor(np.clip(out, 0, 255).astype(np.uint8), cv2.COLOR_LAB2BGR)\n",
    "\n",
    "\n",
    "def texture_harmonize(proc, orig, blend=0.25):\n",
    "    hf = orig.astype(np.float32) - cv2.GaussianBlur(orig,(21,21),0).astype(np.float32)\n",
    "    return np.clip(proc.astype(np.float32) + hf * blend, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def contrast_balance(img, clip=1.5):\n",
    "    lab = cv2.cvtColor(img, cv2.COLOR_BGR2LAB)\n",
    "    l, a, b = cv2.split(lab)\n",
    "    cl = cv2.createCLAHE(clipLimit=clip, tileGridSize=(8,8)).apply(l)\n",
    "    return cv2.cvtColor(cv2.merge([cv2.addWeighted(l,0.7,cl,0.3,0), a, b]),\n",
    "                        cv2.COLOR_LAB2BGR)\n",
    "\n",
    "\n",
    "def edge_stabilize(proc, orig, emask):\n",
    "    w = emask[:,:,np.newaxis]\n",
    "    return np.clip(proc.astype(np.float32)*(1-w) +\n",
    "                   orig.astype(np.float32)*w, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def refine_consistency(proc, orig, pres_mask, fidelity=0.12):\n",
    "    print('  color match',    end=' ... ', flush=True); proc = color_match(proc, orig);         print('ok')\n",
    "    print('  texture blend',  end=' ... ', flush=True); proc = texture_harmonize(proc, orig);   print('ok')\n",
    "    print('  contrast',       end=' ... ', flush=True); proc = contrast_balance(proc);          print('ok')\n",
    "    print('  edge stabilize', end=' ... ', flush=True);\n",
    "    proc = edge_stabilize(proc, orig, major_edges(orig));  print('ok')\n",
    "    final = proc.astype(np.float32)*(1-fidelity) + orig.astype(np.float32)*fidelity\n",
    "    return np.clip(final, 0, 255).astype(np.uint8)\n",
    "\n",
    "print('Stage 5 loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c-pipe-md",
   "metadata": {},
   "source": [
    "## Main Pipeline\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c-pipeline",
   "metadata": {},
   "outputs": [],
   "source": [
    "# MAIN PIPELINE - orchestrates all 5 stages\n",
    "MAX_DIM = 4096\n",
    "\n",
    "def run_pipeline(img_bgr, artifact_strength=1.0, denoise_strength=1.0,\n",
    "                 restoration_strength=0.7, restoration_model='realesrgan_general',\n",
    "                 tile_size=512):\n",
    "    orig = img_bgr.copy()\n",
    "    h0, w0 = orig.shape[:2]\n",
    "    print(f'Input: {w0} x {h0} px')\n",
    "\n",
    "    sc = min(1.0, MAX_DIM / max(h0, w0))\n",
    "    work = orig if sc == 1.0 else cv2.resize(\n",
    "        orig, (int(w0*sc), int(h0*sc)), interpolation=cv2.INTER_LANCZOS4)\n",
    "    if sc < 1.0:\n",
    "        print(f'Working at {work.shape[1]} x {work.shape[0]} px')\n",
    "\n",
    "    print('\\n[Stage 1] Artifact detection')\n",
    "    amap = generate_artifact_map(work, strength=artifact_strength)\n",
    "\n",
    "    print('\\n[Stage 2] Preservation mask')\n",
    "    pmask = build_preservation_mask(work)\n",
    "    print('  ok')\n",
    "\n",
    "    print('\\n[Stage 3] Artifact suppression')\n",
    "    supp = suppress_artifacts(work, amap, pmask, denoise_strength)\n",
    "\n",
    "    print(f'\\n[Stage 4] AI restoration  model={restoration_model}')\n",
    "    rest = restore_image(supp, model_type=restoration_model,\n",
    "                         strength=restoration_strength, tile=tile_size)\n",
    "\n",
    "    print('\\n[Stage 5] Consistency refinement')\n",
    "    refined = refine_consistency(rest, work, pmask)\n",
    "\n",
    "    if sc < 1.0:\n",
    "        refined = cv2.resize(refined, (w0, h0), interpolation=cv2.INTER_LANCZOS4)\n",
    "        amap    = cv2.resize(amap,    (w0, h0))\n",
    "\n",
    "    print('\\nDone.')\n",
    "    return refined, amap\n",
    "\n",
    "print('Pipeline loaded.')\n"
   ]
  },
