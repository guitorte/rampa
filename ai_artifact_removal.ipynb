   "source": [
    "## Stage 5 - Consistency Refinement\n",
    "Post-processes the restored image to lock colour, texture and contrast back to the original reference, and re-sharpens structural edges.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-stage5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# STAGE 5 - Consistency Refinement Functions\n",
    "# ============================================================\n",
    "\n",
    "def color_statistics_match(processed: np.ndarray,\n",
    "                             reference: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Match per-channel LAB mean/std of processed to reference.\n",
    "    Corrects colour drift introduced by Stage 4.\n",
    "    \"\"\"\n",
    "    proc_lab = cv2.cvtColor(processed, cv2.COLOR_BGR2LAB).astype(np.float32)\n",
    "    ref_lab  = cv2.cvtColor(reference, cv2.COLOR_BGR2LAB).astype(np.float32)\n",
    "    out_lab  = np.zeros_like(proc_lab)\n",
    "    for c in range(3):\n",
    "        p_mu, p_sd = proc_lab[:, :, c].mean(), proc_lab[:, :, c].std() + 1e-8\n",
    "        r_mu, r_sd = ref_lab[:, :, c].mean(),  ref_lab[:, :, c].std()  + 1e-8\n",
    "        out_lab[:, :, c] = (proc_lab[:, :, c] - p_mu) * (r_sd / p_sd) + r_mu\n",
    "    out_lab = np.clip(out_lab, 0, 255).astype(np.uint8)\n",
    "    return cv2.cvtColor(out_lab, cv2.COLOR_LAB2BGR)\n",
    "\n",
    "\n",
    "def texture_harmonize(processed: np.ndarray,\n",
    "                       original: np.ndarray,\n",
    "                       blend: float = 0.25) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Re-inject some original high-frequency texture to prevent\n",
    "    over-smoothing or hallucinated texture from the AI model.\n",
    "    \"\"\"\n",
    "    orig_low = cv2.GaussianBlur(original, (21, 21), 0).astype(np.float32)\n",
    "    orig_hf  = original.astype(np.float32) - orig_low\n",
    "    result   = processed.astype(np.float32) + orig_hf * blend\n",
    "    return np.clip(result, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def local_contrast_balance(img_bgr: np.ndarray,\n",
    "                             clip_limit: float = 1.5,\n",
    "                             grid: tuple = (8, 8)) -> np.ndarray:\n",
    "    \"\"\"Gentle CLAHE on the L channel to re-balance contrast without new artifacts.\"\"\"\n",
    "    lab = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2LAB)\n",
    "    l, a, b = cv2.split(lab)\n",
    "    clahe = cv2.createCLAHE(clipLimit=clip_limit, tileGridSize=grid)\n",
    "    l_eq  = clahe.apply(l)\n",
    "    l_out = cv2.addWeighted(l, 0.7, l_eq, 0.3, 0)\n",
    "    return cv2.cvtColor(cv2.merge([l_out, a, b]), cv2.COLOR_LAB2BGR)\n",
    "\n",
    "\n",
    "def stabilize_edges(processed: np.ndarray,\n",
    "                     original: np.ndarray,\n",
    "                     edge_mask: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Restore original pixel values along structural edges.\"\"\"\n",
    "    w = edge_mask[:, :, np.newaxis]\n",
    "    result = processed.astype(np.float32) * (1.0 - w) + original.astype(np.float32) * w\n",
    "    return np.clip(result, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def refine_consistency(\n",
    "    processed: np.ndarray,\n",
    "    original:  np.ndarray,\n",
    "    preservation_mask: np.ndarray,\n",
    "    final_fidelity: float = 0.12\n",
    ") -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Apply all Stage-5 refinements in sequence.\n",
    "    final_fidelity: fraction of original blended in as a safety net\n",
    "    against large colour/content drift.\n",
    "    \"\"\"\n",
    "    print('  Colour statistics match...', end=' ', flush=True)\n",
    "    result = color_statistics_match(processed, original)\n",
    "    print('done')\n",
    "\n",
    "    print('  Texture harmonisation...', end=' ', flush=True)\n",
    "    result = texture_harmonize(result, original, blend=0.25)\n",
    "    print('done')\n",
    "\n",
    "    print('  Local contrast balance...', end=' ', flush=True)\n",
    "    result = local_contrast_balance(result)\n",
    "    print('done')\n",
    "\n",
    "    print('  Edge stabilisation...', end=' ', flush=True)\n",
    "    edge_mask = extract_major_edges(original)\n",
    "    result = stabilize_edges(result, original, edge_mask)\n",
    "    print('done')\n",
    "\n",
    "    final = (result.astype(np.float32) * (1.0 - final_fidelity) +\n",
    "             original.astype(np.float32) * final_fidelity)\n",
    "    return np.clip(final, 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "print('Stage 5 functions loaded.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-pipeline-md",
   "metadata": {},
   "source": [
    "## Main Pipeline Orchestrator\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-pipeline",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# MAIN PIPELINE - Orchestrates all 5 stages\n",
    "# ============================================================\n",
    "\n",
    "MAX_DIM_FOR_PROCESSING = 4096\n",
    "\n",
    "\n",
    "def _maybe_downscale(img_bgr: np.ndarray,\n",
    "                      max_dim: int = MAX_DIM_FOR_PROCESSING):\n",
    "    \"\"\"Return (working_img, scale). scale < 1.0 means we downscaled.\"\"\"\n",
    "    h, w = img_bgr.shape[:2]\n",
    "    if max(h, w) <= max_dim:\n",
    "        return img_bgr, 1.0\n",
    "    scale = max_dim / max(h, w)\n",
    "    small = cv2.resize(img_bgr, (int(w * scale), int(h * scale)),\n",
    "                        interpolation=cv2.INTER_LANCZOS4)\n",
    "    return small, scale\n",
    "\n",
    "\n",
    "def run_pipeline(\n",
    "    img_bgr: np.ndarray,\n",
    "    artifact_strength:    float = 1.0,\n",
    "    denoise_strength:     float = 1.0,\n",
    "    restoration_strength: float = 0.7,\n",
    "    restoration_model:    str   = 'realesrgan_general',\n",
    "    tile_size:            int   = 512,\n",
    "):\n",
    "    \"\"\"\n",
    "    Full 5-stage artifact removal pipeline.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    img_bgr              : Input image (BGR uint8).\n",
    "    artifact_strength    : Detection sensitivity  (0.1-2.0, default 1.0).\n",
    "    denoise_strength     : Classical filter intensity (0.1-2.0, default 1.0).\n",
    "    restoration_strength : AI model blend factor (0.0-1.0, default 0.7).\n",
    "    restoration_model    : 'realesrgan_general', 'realesrgan_anime', 'swinir', 'none'.\n",
    "    tile_size            : GPU tile size in pixels (smaller = less VRAM needed).\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    result       : Cleaned image (BGR uint8), same dimensions as input.\n",
    "    artifact_map : Float32 probability map, values in [0, 1].\n",
    "    \"\"\"\n",
    "    original = img_bgr.copy()\n",
    "    h_orig, w_orig = original.shape[:2]\n",
    "\n",
    "    print(f'Input: {w_orig} x {h_orig} px')\n",
    "    work, scale = _maybe_downscale(original)\n",
    "    if scale < 1.0:\n",
    "        print(f'Scaled down to {work.shape[1]} x {work.shape[0]} px for processing')\n",
    "\n",
    "    print('\\n[Stage 1] Artifact detection')\n",
    "    artifact_map = generate_artifact_map(work, strength=artifact_strength)\n",
    "\n",
    "    print('\\n[Stage 2] Structural preservation mask')\n",
    "    pres_mask = build_preservation_mask(work)\n",
    "    print('  done')\n",
    "\n",
    "    print('\\n[Stage 3] Artifact suppression')\n",
    "    suppressed = suppress_artifacts(work, artifact_map, pres_mask,\n",
    "                                     denoise_strength=denoise_strength)\n",
    "\n",
    "    print(f'\\n[Stage 4] AI restoration ({restoration_model})')\n",
    "    restored = restore_image(suppressed,\n",
    "                              model_type=restoration_model,\n",
    "                              restoration_strength=restoration_strength,\n",
    "                              tile_size=tile_size)\n",
    "\n",
    "    print('\\n[Stage 5] Consistency refinement')\n",
    "    refined = refine_consistency(restored, work, pres_mask)\n",
    "\n",
    "    if scale < 1.0:\n",
    "        refined      = cv2.resize(refined, (w_orig, h_orig),\n",
    "                                   interpolation=cv2.INTER_LANCZOS4)\n",
    "        artifact_map = cv2.resize(artifact_map, (w_orig, h_orig))\n",
    "\n",
    "    print('\\nPipeline complete.')\n",
    "    return refined, artifact_map\n",
    "\n",
    "\n",
    "print('Pipeline orchestrator loaded.')\n"
   ]
  },
