    "\n",
    "SUPPORTED_EXT = {'.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.tif', '.webp'}\n",
    "\n",
    "def discover_images(directory: str) -> list:\n",
    "    \"\"\"Return sorted list of image paths under directory.\"\"\"\n",
    "    if not os.path.isdir(directory):\n",
    "        print(f'Directory not found: {directory}')\n",
    "        os.makedirs(directory, exist_ok=True)\n",
    "        print(f'Created empty directory. Please add images and rerun.')\n",
    "        return []\n",
    "    found = []\n",
    "    for fname in sorted(os.listdir(directory)):\n",
    "        if os.path.splitext(fname)[1].lower() in SUPPORTED_EXT:\n",
    "            found.append(os.path.join(directory, fname))\n",
    "    return found\n",
    "\n",
    "ARTWORK_FILES = discover_images(ARTWORK_DIR)\n",
    "\n",
    "print(f'Artwork directory: {ARTWORK_DIR}')\n",
    "print(f'Output directory:  {OUTPUT_DIR}')\n",
    "print(f'Found {len(ARTWORK_FILES)} image(s):')\n",
    "for i, fpath in enumerate(ARTWORK_FILES):\n",
    "    size_mb = os.path.getsize(fpath) / 1_048_576\n",
    "    print(f'  [{i:02d}]  {os.path.basename(fpath):<50s}  ({size_mb:.2f} MB)')\n"
